# DIRE IMPACT Platform — credential template
# Copy this file to .env and fill in your own free API credentials.
# NEVER commit your filled-in .env file.

# NASA Earthdata (MODIS land cover/vegetation, NASADEM elevation)
# Free account: https://urs.earthdata.nasa.gov/  — see docs/data-sources/nasa-earthdata.md
EARTHDATA_TOKEN=

# Copernicus Climate Data Store (ERA5-Land climate reanalysis)
# Free account: https://cds.climate.copernicus.eu/  — see docs/data-sources/copernicus-cds.md
CDS_API_KEY=

# Optional: object storage for pipeline I/O (only if using S3-routed runs)
# AWS_PROFILE=
# AWS_REGION=
